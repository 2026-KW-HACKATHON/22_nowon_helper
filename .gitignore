# Installed libraries. `npm install` brings them back, so we never
# commit them.
node_modules/

# Secrets. The Supabase service_role key ignores RLS, so it gives full
# access to every table. Files with keys stay out of git. Commit
# .env.example with empty values instead.
.env
.env.*
!.env.example

# Build output
dist/
build/
*.tsbuildinfo

# Expo and React Native (app/**). The key files below sign the app,
# so they are secrets too.
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Logs and local runs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
coverage/

# Editor settings. Personal ones are not shared, but the list of
# recommended extensions is.
.vscode/*
!.vscode/extensions.json
.idea/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini
