# Copy this file to .env and fill in the values. .env is in .gitignore;
# this file is the only one that goes into git, and it stays empty.
#
# Where to find the values: Supabase dashboard → Project Settings.
# Never paste them into a chat, an issue, a screenshot or a commit.

# Database → Connection string. Paste it as the dashboard shows it.
# Gives full access to the database: backend only.
# For `npm run db:check` the read-only role from db/readonly_role.sql
# is enough.
DATABASE_URL=

# API → Project URL. Safe for the mobile app.
SUPABASE_URL=

# API → anon public key. Safe for the mobile app: RLS lets it read
# only the public columns of `reports`.
# The API also uses it to check the operator's login token.
SUPABASE_ANON_KEY=

# Optional. Kakao Developers → app → REST API key. Turns the coordinates
# of a new report into an address ("월계동 광운로 20"). Empty → the
# report is created with an empty address. Backend only.
KAKAO_REST_API_KEY=
